rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParticipantList(participants) {
      return participants is list
        && participants.size() == 2
        && participants[0] is string
        && participants[1] is string;
    }

    function matchesPrivateChatId(docId, participants) {
      return isParticipantList(participants)
        && (
          docId == participants[0] + '_' + participants[1]
          || docId == participants[1] + '_' + participants[0]
        );
    }

    function isParticipant(data) {
      return signedIn()
        && data != null
        && data.participants is list
        && request.auth.uid in data.participants;
    }

    function matchesUserPairDocId(docId) {
      return signedIn()
        && request.auth.uid is string
        && request.auth.uid.size() > 0
        && (
          docId.matches('^' + request.auth.uid + '_[^/]+$')
          || docId.matches('^[^/]+' + '_' + request.auth.uid + '$')
        );
    }

    function validCallStatus(status) {
      return status in ['ringing', 'connecting', 'active', 'rejected', 'cancelled', 'missed', 'ended'];
    }

    function validEmbeddedPrivateCall(data, participants, chatId) {
      return data is map
        && data.callId is string
        && data.chatId is string
        && data.callId == chatId
        && data.chatId == chatId
        && isParticipantList(data.participants)
        && participants.hasAll(data.participants)
        && data.participants.hasAll(participants)
        && data.participants.hasAll([data.fromUid, data.toUid])
        && data.fromUid is string
        && data.toUid is string
        && data.mode is string
        && (data.mode == 'audio' || data.mode == 'video')
        && data.status is string
        && validCallStatus(data.status)
        && data.createdAtMs is int
        && data.updatedAtMs is int
        && (!data.keys().hasAny(['startedAtMs']) || data.startedAtMs is int)
        && (!data.keys().hasAny(['endedAtMs']) || data.endedAtMs is int)
        && (!data.keys().hasAny(['endedBy']) || data.endedBy is string)
        && (!data.keys().hasAny(['callDurationMs']) || data.callDurationMs is int);
    }

    function validPrivateChat(data) {
      return data.chatId is string
        && isParticipantList(data.participants)
        && data.createdAtMs is int
        && data.updatedAtMs is int
        && data.lastMessageAtMs is int
        && data.lastMessageSenderId is string
        && data.lastMessageText is string
        && data.lastMessageText.size() <= 500
        && data.unreadCounts is map
        && data.typing is map
        && (!data.keys().hasAny(['activeCall']) || validEmbeddedPrivateCall(data.activeCall, data.participants, data.chatId));
    }

    function validMessage(data, participants) {
      return data.senderId is string
        && data.recipientId is string
        && participants.hasAll([data.senderId, data.recipientId])
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 1200
        && data.timestampMs is int
        && data.isRead is bool
        && data.deleted is bool
        && (!data.keys().hasAny(['editedAtMs']) || data.editedAtMs is int)
        && (!data.keys().hasAny(['readAtMs']) || data.readAtMs is int);
    }

    function validPrivateCall(data) {
      return data.callId is string
        && data.chatId is string
        && isParticipantList(data.participants)
        && data.participants.hasAll([data.fromUid, data.toUid])
        && data.fromUid is string
        && data.toUid is string
        && data.mode is string
        && (data.mode == 'audio' || data.mode == 'video')
        && data.status is string
        && validCallStatus(data.status)
        && data.createdAtMs is int
        && data.updatedAtMs is int
        && (!data.keys().hasAny(['startedAtMs']) || data.startedAtMs is int)
        && (!data.keys().hasAny(['endedAtMs']) || data.endedAtMs is int)
        && (!data.keys().hasAny(['endedBy']) || data.endedBy is string)
        && (!data.keys().hasAny(['callDurationMs']) || data.callDurationMs is int);
    }

    function validSignal(data, participants) {
      return data.sender is string
        && data.receiver is string
        && participants.hasAll([data.sender, data.receiver])
        && data.type is string
        && (data.type == 'offer' || data.type == 'answer' || data.type == 'ice')
        && data.data is map
        && data.timestampMs is int;
    }

    match /privateChats/{chatId} {
      allow get: if isParticipant(resource.data) || matchesUserPairDocId(chatId);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.chatId == chatId
        && isParticipant(request.resource.data)
        && matchesPrivateChatId(chatId, request.resource.data.participants)
        && validPrivateChat(request.resource.data);
      allow update: if signedIn()
        && request.resource.data.chatId == chatId
        && isParticipant(request.resource.data)
        && matchesPrivateChatId(chatId, request.resource.data.participants)
        && validPrivateChat(request.resource.data);
      allow delete: if isParticipant(resource.data);

      match /messages/{messageId} {
        function chatData() {
          return get(/databases/$(database)/documents/privateChats/$(chatId)).data;
        }

        allow read: if isParticipant(chatData());

        allow create: if isParticipant(chatData())
          && request.resource.data.senderId == request.auth.uid
          && validMessage(request.resource.data, chatData().participants);

        allow update: if isParticipant(chatData())
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.recipientId == resource.data.recipientId
          && validMessage(request.resource.data, chatData().participants)
          && (
            (
              request.auth.uid == resource.data.senderId
              && request.resource.data.diff(resource.data).changedKeys().hasOnly(['text', 'deleted', 'editedAtMs'])
            ) || (
              request.auth.uid == resource.data.recipientId
              && request.resource.data.isRead == true
              && request.resource.data.diff(resource.data).changedKeys().hasOnly(['isRead', 'readAtMs'])
            )
          );

        allow delete: if isParticipant(chatData())
          && request.auth.uid == resource.data.senderId;
      }
    }

    match /privateCalls/{callId} {
      allow get: if isParticipant(resource.data) || matchesUserPairDocId(callId);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.callId == callId
        && request.resource.data.chatId == callId
        && request.resource.data.fromUid == request.auth.uid
        && isParticipant(request.resource.data)
        && matchesPrivateChatId(callId, request.resource.data.participants)
        && validPrivateCall(request.resource.data);
      allow update: if signedIn()
        && request.resource.data.callId == callId
        && request.resource.data.chatId == callId
        && isParticipant(request.resource.data)
        && matchesPrivateChatId(callId, request.resource.data.participants)
        && validPrivateCall(request.resource.data);
      allow delete: if isParticipant(resource.data);

      match /signals/{signalId} {
        function callData() {
          return get(/databases/$(database)/documents/privateCalls/$(callId)).data;
        }

        allow read: if isParticipant(callData());
        allow create: if isParticipant(callData())
          && request.resource.data.sender == request.auth.uid
          && validSignal(request.resource.data, callData().participants);
        allow update: if false;
        allow delete: if isParticipant(callData())
          && (request.auth.uid == resource.data.sender || request.auth.uid == resource.data.receiver);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
